# 复制本文件为 .env 并填入你申请的密钥（不要提交 .env 到仓库）
# 申请步骤见 ../docs/api-readme.md

# —— Azure 语音评测（发音评分）——
# 免费 F0 档：每月 5 音频小时，长期有效，不过期
# 申请：Azure 门户 → 创建 "Speech" 资源 → Keys and Endpoint 复制 Key 与 Region
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# —— OCR.space（拍照录入云端识别，可选）——
# 免费档：25,000 次/月，无需信用卡，邮箱注册
# 申请：https://ocr.space/ 注册获取 API Key
OCR_SPACE_KEY=

# —— 服务端口（可选）——
PORT=3000
